# Example systemd unit: /etc/systemd/system/sgsu.service, then
#   systemctl daemon-reload && systemctl enable --now sgsu
# The console stays reachable with: sudo -u steam screen -r SGSU   (Ctrl+A, D to leave it)
# Restart=always restarts the screen if it dies; run-server.sh restarts the server after a crash.
[Unit]
Description=Special Unit (UT2004) dedicated server (Stargate Redial)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=steam
Environment=UT2004=/home/steam/ut2004 PORT=7810 BOTS=8 MAP=SU-Abydos
# Environment=IP=203.0.113.10
ExecStart=/usr/bin/screen -DmS SGSU /home/steam/sgsu-server/run-server.sh
Restart=always
RestartSec=10
# 8 bots on a map fit in about 150 MB; more is a leak.
MemoryMax=1G

[Install]
WantedBy=multi-user.target
